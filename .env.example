# Copier en .env et renseigner la clé (https://fr.numista.com/api/)
NUMISTA_API_KEY=
NUMISTA_CLIENT_ID=

# Reconnaissance d'une pièce par photo avec un modèle de vision (https://openrouter.ai/keys).
# Facultatif : sans clé, seule la comparaison locale est utilisée. Voir server/identify.py.
OPEN_ROUTER_API_KEY=
# Code PIN demandé dans le scanner pour utiliser ce modèle (accès administrateur) : obligatoire.
ADMIN_ACCESS=
